generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

// 🟡 CHANGED (cat → dog): was CAT / NOT_CAT
enum Label {
    DOG
    NOT_DOG
}

enum Ground {
    training 
    testing
}

model Photo {
    id          String   @id @default(uuid())
    storagePath String   @unique
    label       Label?
    ground      Ground?  @default(training)
    createdAt   DateTime @default(now())

    @@map("photo")
}